# Local AI via Ollama (https://ollama.com). Nothing leaves your machine, no API key.
OLLAMA_HOST=http://127.0.0.1:11434
# Vision model: reads handwriting/PDF pages and is also used for grading (one model = no VRAM swapping).
# Use an -instruct tag: the plain qwen3-vl tags are "thinking" models and are very slow here.
# 4GB GPU: qwen3-vl:2b-instruct (fits fully in VRAM, fast). 6GB+: qwen3-vl:4b-instruct (more accurate).
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
# Optional: a separate text-only model for grading (e.g. qwen3:8b if you have 8GB+ VRAM).
# OLLAMA_TEXT_MODEL=qwen3:4b
# Embeddings for reasoning-graph matching. Leave empty to use lexical similarity instead.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window. Each scanned page is ~1k tokens; raise for long scripts (uses more VRAM).
OLLAMA_NUM_CTX=8192
# Concurrent requests to Ollama. Keep 1 on a single small GPU.
OLLAMA_PARALLEL=1
# PDF render scale (1.5 = good balance; 2 = sharper OCR but slower)
OLLAMA_PDF_SCALE=1.5
OLLAMA_MAX_PAGES=20
PORT=4000
# MOCK_AI=1 runs the whole pipeline with fake AI output (for testing without a model)
# MOCK_AI=1
# MOCK_AI_DELAY_MS=2500   (slow the fake AI down to watch the workflow page live)
